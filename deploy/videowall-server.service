[Unit]
Description=VideoWall - servidor (API + painel + player web)
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=-__INSTALL_DIR__/config/videowall.env
ExecStart=/usr/bin/python3 __INSTALL_DIR__/run.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
