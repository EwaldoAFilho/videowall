# Variáveis do docker compose. Copie para ".env" na mesma pasta e ajuste.
# (O arquivo .env é lido automaticamente pelo "docker compose" e não vai pro git.)

# Onde publicar a porta do servidor:
#   (vazio/ausente) -> 127.0.0.1:8777  (só localhost — padrão seguro)
#   8777            -> 0.0.0.0:8777     (exposto na LAN; use com proxy/firewall)
#   192.168.201.184:8777 -> só nessa interface
#VIDEOWALL_PUBLISH=8777
