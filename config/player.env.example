# Configuração do player (modo kiosk).
# Copie para player.env e ajuste conforme necessário.

# URL do player (mude a porta se alterou no servidor)
VIDEOWALL_URL=http://127.0.0.1:8777/player

# Modo de exibição quando iniciado sem argumentos:
#   kiosk -> tela cheia em um monitor (padrão)
#   span  -> janela cobrindo todos os monitores (requer X11)
#VIDEOWALL_PLAYER_MODE=kiosk

# Em modo span, força o tamanho da janela (detectado via xrandr por padrão)
#VIDEOWALL_WINDOW_W=3840
#VIDEOWALL_WINDOW_H=1080

# Em modo kiosk, em qual posição abrir (use para escolher o monitor; ex.: 1920,0)
#VIDEOWALL_WINDOW_POS=0,0

# Perfil do navegador do player (logins de dashboards ficam salvos aqui)
#VIDEOWALL_PROFILE=$HOME/.config/videowall-player
