# Configuração do servidor VideoWall.
# Copie para videowall.env e ajuste conforme necessário.

# Endereço de escuta. 127.0.0.1 = apenas local (recomendado).
# Use 0.0.0.0 SOMENTE se precisar administrar de outra máquina da rede,
# de preferência atrás de firewall/VPN.
VIDEOWALL_BIND=127.0.0.1

# Porta do servidor
VIDEOWALL_PORT=8777

# Diretório de dados (banco, mídia, logs, backups)
#VIDEOWALL_DATA=/opt/videowall/data

# Tamanho máximo de upload em MB
#VIDEOWALL_MAX_UPLOAD_MB=4096
